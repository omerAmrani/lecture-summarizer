{
  "name": "lecture-summarizer",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "predev": "lsof -ti:3001,3002 | xargs kill -9 2>/dev/null; true",
    "dev": "pnpm -r --parallel dev",
    "tray:build": "pnpm -r build && bash tray/mac/build.sh",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm -r --if-present check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
