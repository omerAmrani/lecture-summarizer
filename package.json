{
  "name": "lecture-summarizer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "lsof -ti:3001,3002 | xargs kill -9 2>/dev/null; true",
    "dev": "turbo run dev --filter=@lecture-summarizer/api --filter=@lecture-summarizer/web --parallel",
    "tray:build": "turbo run build --filter=@lecture-summarizer/api --filter=@lecture-summarizer/web && bash tray/mac/build.sh",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
